# Copia in .env.local per lo sviluppo locale.
# Su Vercel: Project → Settings → Environment Variables (Production, Preview, Development).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Solo server-side: necessaria per l'eliminazione account (API route).
# Supabase → Project Settings → API → service_role (non esporre al client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
